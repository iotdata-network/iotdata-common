# sdkconfig.defaults — common ESP-IDF config baseline for the iotdata esp32 projects.
#
# SINGLE SOURCE OF TRUTH. target-esp32.mk seeds a project's local sdkconfig.defaults from
# this file on first build (only if absent — it is never overwritten afterwards), appending
# an optional per-host sdkconfig.<hostname>.defaults. This keeps every esp32 project on one
# consistent IDF config instead of the drift that per-project copies accumulate.
#
# To change the baseline: edit THIS file, then delete a project's local sdkconfig.defaults so
# the next build re-seeds it. Host-specific tweaks belong in that project's per-host file, not
# here. The settings below are the safe superset of all the projects: each is either wanted by
# a node type or an inert no-op for the others (e.g. the deep-sleep options do nothing on the
# always-on relay; the 10s watchdog just gives the sensors more headroom).
#
# All current boards are esp32c3. The concrete IDF_TARGET is set by `idf.py set-target`, not here.

# --- console: USB Serial/JTAG only, no UART console ---
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG_ENABLED=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
CONFIG_ESP_CONSOLE_UART_NUM=-1
CONFIG_ESP_CONSOLE_ROM_SERIAL_PORT_NUM=3

# --- size-optimised build ---
CONFIG_COMPILER_OPTIMIZATION_SIZE=y

# --- logging: keep DEBUG compiled in so esp_log_level_set (or a rebuild) can surface a
#     driver's per-frame hex dump; default runtime level is INFO. `make release` strips the
#     strings out of flash entirely by flipping LOG_MAXIMUM_LEVEL to NONE. ---
CONFIG_LOG_MAXIMUM_LEVEL_DEBUG=y
CONFIG_LOG_MAXIMUM_LEVEL=4
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# --- quiet the boot chatter: silence the ROM log entirely (drops the banner on EVERY wake —
#     and on boards where an E22 control pin doubles as U0TXD, e.g. tsa's M1=GPIO21, keeps that
#     pin from toggling with the banner at reset), plus the 2nd-stage bootloader log. ---
CONFIG_BOOT_ROM_LOG_ALWAYS_OFF=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL=0

# --- Task Watchdog: reset the chip on timeout (don't just log) so a wedged, unattended node
#     recovers itself instead of staying awake draining the battery. The app task subscribes and
#     is patted from its yield/sleep helper (see each app's main). 10s comfortably clears the
#     longest single un-patted wait — e.g. the tsa WIFI path's 5s MQTT puback take. ---
CONFIG_ESP_TASK_WDT_INIT=y
CONFIG_ESP_TASK_WDT_PANIC=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# --- deep sleep: skip app-image re-validation on wake (faster) and power the flash down while
#     asleep. Wanted by the pump-and-dump sensors; an inert no-op for the always-on relay. ---
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
CONFIG_ESP_SLEEP_POWER_DOWN_FLASH=y

# --- reproducible build: strip absolute build paths and timestamps so identical sources
#     produce a byte-identical binary. ---
CONFIG_APP_REPRODUCIBLE_BUILD=y
