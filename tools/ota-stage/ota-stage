#!/usr/bin/env node
/*
 * ota-stage -- put a built release into a deployment's release tree, with a manifest.
 *
 *   ota-stage -d .../iotdata-deploy/se-67194/release -n relay   --version 0.9.9 --build build_release
 *   ota-stage -d .../iotdata-deploy/se-67194/release -n gateway --version 0.9.8 --app iotdata_gateway --stamp-file iotdata_gateway.buildinfo
 *
 * TWO PLATFORM SHAPES, ONE MANIFEST. An esp32 release is a flash set -- bootloader, partition table,
 * otadata, app -- described by ESP-IDF's flasher_args.json. A linux release is one executable. What
 * they share is the `iotdata` block: name, version, platform, stamp, bootloader floor, and an `ota`
 * entry naming the single file an update carries. Everything downstream (ota-bundle, the packaging
 * rules, an eventual client) reads only that block, so it does not care which shape produced it.
 *
 * That is the whole reason this is one tool rather than two: a second writer is a second chance for
 * the manifest to drift, and the manifest is the contract.
 *
 * THE STAMP CANNOT BE INVENTED HERE. It is generated by `date -u` when the binary is compiled and is
 * the field everything orders by, so re-deriving it at staging time would produce a confident lie.
 * esp32 builds record it in CMakeCache.txt; linux builds write it beside the binary (see the
 * buildinfo rule in target-linux.mk). Absent, staging says so loudly rather than guessing.
 */
'use strict';
const fs = require('fs'),
    path = require('path'),
    crypto = require('crypto'),
    { execFileSync } = require('child_process');

const die = (m) => {
    console.error('ota-stage: ' + m);
    process.exit(1);
};
const C = { cyan: '\u001b[36m', green: '\u001b[32m', warn: '\u001b[33m', off: '\u001b[0m' };

const A = process.argv.slice(2),
    opt = (n, d) => {
        const i = A.indexOf('--' + n);
        return i >= 0 && A[i + 1] !== undefined ? A[i + 1] : d;
    },
    sopt = (s, n, d) => {
        const i = A.indexOf('-' + s);
        return i >= 0 && A[i + 1] !== undefined ? A[i + 1] : opt(n, d);
    };
if (A.length === 0 || A.includes('-h') || A.includes('--help')) {
    console.log(`usage: ota-stage [options]
  -d, --dir DIR        the release tree (<deployment>/release)      [required]
  -n, --name NAME      release name, as the node reports itself     [required]
      --version V      release version                             [required]
      --platform P     subtree: esp32c3 | aarch64 | x86_64 | ...    (derived when it can be)
      --bootloader-min N  minimum bootloader this release needs     (default 1)
      --force          overwrite a release of this name and version
  esp32 (a flash set):
      --build DIR      an ESP-IDF build directory with flasher_args.json
  linux (one executable):
      --app FILE       the built binary
      --stamp-file F   where to read the build stamp from (default <app>.buildinfo)`);
    process.exit(0);
}

const ROOT = sopt('d', 'dir', null) || die('set -d <release tree, e.g. .../iotdata-deploy/<deployment>/release>');
const NAME = sopt('n', 'name', null) || die('set -n <name>');
const VERSION = opt('version', null) || die('set --version <version>');
const BOOTLOADER_MIN = parseInt(opt('bootloader-min', '1'), 10);
const FORCE = A.includes('--force');
const BUILD = opt('build', null);
const APP = opt('app', null);
if (!BUILD && !APP) die('give either --build <esp-idf build dir> or --app <binary>');
if (BUILD && APP) die('--build and --app are the two shapes; pick one');

const sha256 = (p) => crypto.createHash('sha256').update(fs.readFileSync(p)).digest('hex');

/*
 * THE RAW IMAGE'S DIGEST, which is NOT sha256 of the .bin file and is the number an OTA header's
 * TARGET_HASH and BASE_HASH are taken over.
 *
 * esptool appends 32 bytes of sha256 to an app image and sets hash_appended in the image header.
 * That makes sha256(whole file) a number nothing else can reproduce -- it is a hash OF a hash OF
 * the image -- and in particular a device cannot get it back: what a device can compute for an
 * image in flash is the digest of the image WITHOUT those 32 bytes, because that is what they are.
 *
 * So the identity of an image here is the bare image: everything esptool actually built, and none
 * of its metadata about it. That is a definition both ends can produce independently, and the
 * device's version of it is verified rather than trusted -- esp_partition_get_sha256 recomputes it
 * over image_len - 32 and refuses the partition if the appended bytes disagree.
 *
 * It is READ from the tail rather than recomputed, and then CHECKED by recomputing, so a file whose
 * appended hash does not describe it is caught here at staging instead of on a node.
 */
const HASH_APPENDED_LEN = 32;
function imageSha256(p) {
    const buf = fs.readFileSync(p);
    if (buf.length < 64 || buf[0] !== 0xe9) die(`${p} is not an esp32 app image (magic 0x${buf[0].toString(16)})`);
    if (buf[23] !== 1) die(`${p} has no appended sha256 (hash_appended=${buf[23]}) -- nothing can identify it`);
    const appended = buf.subarray(buf.length - HASH_APPENDED_LEN).toString('hex');
    const computed = crypto.createHash('sha256').update(buf.subarray(0, buf.length - HASH_APPENDED_LEN)).digest('hex');
    if (appended !== computed) die(`${p} is corrupt: its appended sha256 does not match its contents`);
    return computed;
}

/* ---- identity recorded by the build, never re-derived here ------------------------------- */

function buildIdentity() {
    if (BUILD) {
        /* esp32: idf writes every -D into its cache, so the compiled-in values are recoverable */
        const p = path.join(BUILD, 'CMakeCache.txt');
        const out = {};
        if (fs.existsSync(p))
            for (const line of fs.readFileSync(p, 'utf8').split('\n'))
                for (const k of ['IOTDATA_NODE_VERSION_APP', 'IOTDATA_NODE_VERSION_SEMVER', 'IOTDATA_NODE_VERSION_STAMP'])
                    if (line.startsWith(k + ':') && line.includes('=')) out[k] = line.split('=', 2)[1].trim();
        return { app: out.IOTDATA_NODE_VERSION_APP, semver: out.IOTDATA_NODE_VERSION_SEMVER, stamp: out.IOTDATA_NODE_VERSION_STAMP };
    }
    /* linux: a name=value file the link rule wrote beside the binary */
    const p = opt('stamp-file', APP + '.buildinfo');
    if (!fs.existsSync(p)) return {};
    const out = {};
    for (const line of fs.readFileSync(p, 'utf8').split('\n')) {
        const i = line.indexOf('=');
        if (i > 0) out[line.slice(0, i).trim()] = line.slice(i + 1).trim();
    }
    return { app: out.name, semver: out.version, stamp: out.stamp };
}

/* ---- platform: derived from the artefact where that is reliable -------------------------- */

const ELF_MACHINE = { 0x3e: 'x86_64', 0xb7: 'aarch64', 0xf3: 'riscv64', 0x28: 'arm' };
function elfMachine(file) {
    const fd = fs.openSync(file, 'r'), b = Buffer.alloc(20);
    fs.readSync(fd, b, 0, 20, 0);
    fs.closeSync(fd);
    if (b.readUInt32BE(0) !== 0x7f454c46) return null; /* not an ELF */
    return ELF_MACHINE[b.readUInt16LE(18)] || null;
}

function platformOf(fa) {
    const given = opt('platform', null);
    if (BUILD) {
        const chip = fa && fa.extra_esptool_args && fa.extra_esptool_args.chip;
        return given || chip || die('no chip in flasher_args and no --platform given');
    }
    const m = elfMachine(APP);
    if (!given) {
        if (!m) die(`cannot read an ELF machine from ${APP} -- pass --platform`);
        if (m === 'arm') die('this is a 32-bit ARM binary; armv6l and armv7l look alike here -- pass --platform');
        return m;
    }
    /* An explicit --platform is still checked against the binary: staging an aarch64 build into the
       armv6l subtree is a mistake that only shows up on the device, months later. */
    if (m && m !== 'arm' && m !== given) die(`--platform ${given} but ${path.basename(APP)} is ${m}`);
    if (m === 'arm' && !/^arm/.test(given)) die(`--platform ${given} but ${path.basename(APP)} is 32-bit ARM`);
    return given;
}

/* ---- stage ------------------------------------------------------------------------------- */

const fa = BUILD ? JSON.parse(fs.readFileSync(path.join(BUILD, 'flasher_args.json'), 'utf8')) : null;
if (BUILD && !fa.flash_files) die('flasher_args.json has no flash_files');

const platform = platformOf(fa);
const built = buildIdentity();
for (const [label, got, want] of [['name', built.app, NAME], ['version', built.semver, VERSION]])
    if (got !== undefined && got !== want && !FORCE)
        die(`${label} mismatch: staging as ${want} but the build compiled in ${got}\n  rebuild after changing it, or --force to stage it mislabelled`);
if (!built.stamp)
    console.log(`${C.warn}ota-stage: no build stamp found -- an OTA blob from this release will have no ordering key${C.off}`);

const base = `${NAME}-${VERSION}`;
const dest = path.join(ROOT, platform, 'bin');
fs.mkdirSync(dest, { recursive: true });
const manifestPath = path.join(dest, base + '.json');
if (fs.existsSync(manifestPath) && !FORCE) die(`${base} is already staged in ${dest} -- bump the version, or restage over it with --force (from make: STAGE_FORCE=1)`);

const files = {}, outFiles = {};
let appEntry = null;

if (BUILD) {
    /* Roles from flasher_args' own named sections, so an unusual partition set still stages and
       anything unnamed travels under its own basename rather than being dropped. */
    const roleOf = {};
    for (const role of ['bootloader', 'partition-table', 'otadata', 'app'])
        if (fa[role] && fa[role].file) roleOf[fa[role].file] = role;
    for (const [offset, rel] of Object.entries(fa.flash_files)) {
        const src = path.join(BUILD, rel);
        if (!fs.existsSync(src)) die(`missing binary ${rel} in ${BUILD} -- build it first`);
        const role = roleOf[rel];
        const leaf = role ? `${base}.${role}.bin` : `${base}.${path.basename(rel)}`;
        fs.copyFileSync(src, path.join(dest, leaf));
        const info = { size: fs.statSync(src).size, sha256: sha256(src), offset };
        if (role) info.role = role;
        if (role === 'app') info.image_sha256 = imageSha256(src);
        files[leaf] = info;
        outFiles[offset] = leaf;
        if (role === 'app') appEntry = Object.assign({ file: leaf }, info);
    }
} else {
    /* One executable, and it IS the app -- no offsets, nothing to flash around it. */
    const leaf = `${base}.app`;
    fs.copyFileSync(APP, path.join(dest, leaf));
    fs.chmodSync(path.join(dest, leaf), 0o755);
    /* ON LINUX THE FILE *IS* THE IMAGE. There is no esptool header to read a hash_appended flag out
       of and no appended digest to read back, so the identity is the digest of the whole
       executable -- which is exactly what the far end can recompute for the binary it holds.
       Both fields carry the same number here, and that is the honest answer rather than a second
       definition of identity: image_sha256 is what ota-bundle puts in the kvr header and what a
       delta's base is matched on, so it has to be a number both ends can produce.
       imageSha256() is esp32-ONLY -- it refuses anything whose first byte is not 0xe9 -- so calling
       it here meant `make stage` could never succeed for a linux target. */
    const digest = sha256(APP);
    const info = { size: fs.statSync(APP).size, sha256: digest, image_sha256: digest, role: 'app' };
    files[leaf] = info;
    appEntry = Object.assign({ file: leaf }, info);
}

const out = BUILD ? Object.assign({}, fa) : {};
if (BUILD) {
    out.flash_files = outFiles;
    for (const role of ['bootloader', 'partition-table', 'otadata', 'app'])
        if (out[role] && out[role].file) out[role] = Object.assign({}, out[role], { file: `${base}.${role}.bin` });
}
let pd = {};
if (BUILD && fs.existsSync(path.join(BUILD, 'project_description.json')))
    try { pd = JSON.parse(fs.readFileSync(path.join(BUILD, 'project_description.json'), 'utf8')); } catch (e) { pd = {}; }
let git = null;
try {
    git = execFileSync('git', ['-C', path.dirname(path.resolve(BUILD || APP)), 'describe', '--always', '--dirty', '--tags'], { stdio: ['ignore', 'pipe', 'ignore'] }).toString().trim() || null;
} catch (e) { git = null; }

out.iotdata = {
    name: NAME,
    version: VERSION,
    platform: platform,
    chip: BUILD ? (fa.extra_esptool_args || {}).chip || pd.target : undefined,
    staged_utc: new Date().toISOString().replace(/\.\d+Z$/, 'Z'),
    staged_from: path.resolve(BUILD || APP),
    project: BUILD ? pd.project_name : path.basename(APP),
    project_version: BUILD ? pd.project_version : undefined,
    stamp: built.stamp,
    bootloader_min: BOOTLOADER_MIN,
    files: files,
    ota: appEntry,
};
fs.writeFileSync(manifestPath, JSON.stringify(out, null, 2) + '\n');

console.log(`${C.cyan}stage${C.off} ${base} -> ${dest}`);
for (const [leaf, i] of Object.entries(files))
    console.log(`       ${(i.offset || '').padStart(8)}  ${leaf}  ${String(i.size).padStart(8)} B${i.role ? '  [' + i.role + ']' : ''}`);
console.log(`       manifest  ${path.basename(manifestPath)}`);
if (appEntry) console.log(`       ${C.green}ota payload${C.off}  ${appEntry.file}  sha256=${appEntry.sha256.slice(0, 16)}...`);
console.log(`${C.green}stage complete${C.off} -- platform=${platform} stamp=${built.stamp || 'NONE'} bootloader_min=${BOOTLOADER_MIN}`);
