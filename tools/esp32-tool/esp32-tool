#!/usr/bin/env python3

# --------------------------------------------------------------------------------------

"""esp32-tool: work with an ESP32 over USB serial from a host with NO IDF toolchain —
flash it, watch it, drive its CLI, and pull its diagnostics off it.

Built for the split workflow: build on a fast toolchain host (e.g. workshop), then
flash and watch on the target host (e.g. iotdata-tst-3) where the boards are plugged
in. The target needs only python3 + pyserial and, for flashing, esptool — NOT the
compiler/cmake/ninja toolchain.

Subcommands:
    flash     write a build dir's bootloader + partition-table + app to the chip
    monitor   print the serial console, interactive (type to the device's CLI); reconnects.
              Does NOT reset by default (so it won't reboot a running node) — pass -r to reset.
    command   issue ONE command to a running device and print just its response (C-tagged
              lines), filtering out log noise — for scripting. e.g. `command vers`.
    diag      pull the blackbox diagnostics partition off the chip and decode it to CSV
              (`diag extract`), or decode an image pulled earlier (`diag decode <file>`).
              Uses esptool only — no IDF toolchain — and is much faster than streaming the
              records over the console, or erase it (`diag clear --confirm`). NB these
              RESET the device.
    deploy    flash, then monitor  (the usual verb)

The build dir is any ESP-IDF `build/` directory: everything needed (chip, flash
settings, the three binaries and their offsets) is read from its flasher_args.json,
so this works for any project without hardcoding offsets.

Examples:
    # board on ttyACM0, artifacts already local (shared FS, or copied over):
    esp32-tool deploy -p /dev/ttyACM0 -b ../simulator_sensor_lora_esp32/build

    # pull the artifacts off the build host first, then flash + monitor:
    esp32-tool deploy -p /dev/ttyACM1 \
        --pull workshop:/opt/iotdata/src/iotdata-example/simulator_sensor_lora_esp32/build

    # watch a running board and type commands to its CLI (help / vers / stat / logl):
    esp32-tool monitor -p /dev/ttyACM0

    # one-shot: ask a running board for its version, print just the response:
    esp32-tool command -p /dev/ttyACM0 vers

    # flash only, no monitor:
    esp32-tool flash -p /dev/ttyACM0 -b ../relay/build

    # pull weeks of field diagnostics off a node (flush first: the read resets it):
    esp32-tool command -p /dev/ttyACM0 "diag flush"
    esp32-tool diag extract -p /dev/ttyACM0 --raw diag.bin --out diag.csv
    esp32-tool diag decode diag.bin          # offline, re-decode an image pulled earlier

With two boards attached, ttyACM numbering can move across a reset/re-enumerate; to
pin a physical board use a stable path, e.g. -p /dev/serial/by-path/<...> (see
`ls -l /dev/serial/by-path`).

Dependencies on the target host (none are the compiler toolchain):
    python3, pyserial          monitor           -- already present for esp32-boot
    esptool                    flash             -- `pip install esptool`
    rsync + ssh                --pull only
"""

# --------------------------------------------------------------------------------------

import argparse
import json
import os
import re
import select
import shutil
import struct
import subprocess
import sys
import tempfile
import time

# --------------------------------------------------------------------------------------

def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)

VERBOSE = False

def verbose(msg):
    if VERBOSE:
        print(msg, file=sys.stderr)

# --------------------------------------------------------------------------------------

COLORS = {
    "E": "\033[31m",  # red
    "W": "\033[33m",  # yellow
    "I": "\033[32m",  # green
    "C": "\033[36m",  # cyan — iotdata command output ("C (<ms>) ...")
}
RESET = "\033[0m"
RED = "\033[31m"
CYAN = "\033[36m"
LOG_RE = re.compile(r"^[CIDEW] \(\d+\) ")
# Command output is a pseudo log line "C (<ms>) <message>" (iotdata_command.h). Capture the message.
CMD_RE = re.compile(r"^C \(\d+\) (.*)$")
COMMAND_REQUEST = "COMMAND:REQUEST"

def print_line(line):
    match = LOG_RE.match(line)
    if match and line[0] in COLORS:
        print(f"{COLORS[line[0]]}{line}{RESET}")
    else:
        print(line)

def wait_for_port(port, timeout=None):
    """Block until `port` exists. Returns True if it appeared, False on timeout.

    Polls at 10ms because the window can be short: a board that deep-sleeps between cycles is
    only enumerated for a few seconds, and losing that window costs a whole sleep interval."""
    polls = 0
    while not os.path.exists(port):
        if timeout is not None and polls * 0.01 >= timeout:
            return False
        if polls % 50 == 0:
            print(".", end="", flush=True)
        polls += 1
        time.sleep(0.01)
    # The device node appears slightly before the CDC endpoint will accept a connection; without
    # this, grabbing it the instant it shows up can fail with a spurious "port is busy".
    time.sleep(0.05)
    return True

def require_port(args):
    """Every port-using subcommand's precondition: the port is there, or -w waits for it."""
    if os.path.exists(args.port):
        return
    if not getattr(args, "wait", False):
        die(f"{args.port} not found (use -w to wait for it)")
    print(f"waiting for {args.port} (Ctrl-C to give up)", end="", flush=True)
    wait_for_port(args.port)
    print()

def monitor(port, command=None, reset=False):
    import serial  # imported lazily so `flash` works without pyserial
    # Forward the terminal's stdin to the device so typed commands reach its console CLI. In cooked
    # mode a whole line arrives on Enter; we pass the bytes straight through (the device parses lines).
    try:
        stdin_fd = sys.stdin.fileno()
    except (ValueError, OSError, AttributeError):
        stdin_fd = None
    buf = b""
    first_connect = True
    while True:
        if not first_connect:
            print(f"{RED}--- DEVICE DISCONNECTED{RESET}", flush=True)
            wait_for_port(port)
            print(f"\n{RED}--- DEVICE RECONNECTED{RESET}", flush=True)
            buf = b""
        try:
            with serial.Serial(port, 115200, timeout=0) as s:
                if first_connect:
                    if reset:
                        try:
                            s.dtr = False
                            s.rts = True
                            time.sleep(0.1)
                            s.rts = False
                        except OSError:
                            pass
                    first_connect = False
                elif command:
                    # device is already booting — preload the command so it's in the
                    # buffer when the app's acquire step reads it
                    s.write(f"{command}\n".encode())
                    s.flush()
                    print(f"{CYAN}COMMAND:INJECT (preload): {command}{RESET}")
                watch = [s.fileno()] + ([stdin_fd] if stdin_fd is not None else [])
                while True:
                    ready, _, _ = select.select(watch, [], [], 0.2)
                    if stdin_fd is not None and stdin_fd in ready:
                        typed = os.read(stdin_fd, 256)
                        if typed:
                            s.write(typed)  # keystrokes/line -> device console
                            s.flush()
                        else:  # EOF on stdin — stop forwarding, keep monitoring
                            watch = [s.fileno()]
                            stdin_fd = None
                    if s.fileno() in ready:
                        data = s.read(s.in_waiting or 1)
                        if not data:
                            continue
                        buf += data
                        while b"\n" in buf:
                            line, buf = buf.split(b"\n", 1)
                            decoded = line.decode(errors="replace").rstrip("\r")
                            print_line(decoded)
                            if command and COMMAND_REQUEST in decoded:
                                s.write(f"{command}\n".encode())
                                s.flush()
                                print(f"{CYAN}COMMAND:INJECT: {command}{RESET}")
        except serial.SerialException:
            continue

# --------------------------------------------------------------------------------------

def command_oneshot(port, cmd, reset=False, timeout=2.0):
    """Connect to a running device, issue one command, print its 'C (...)' response, exit.
    Returns 0 if any command output was captured, else 1. ESP_LOG noise is filtered out."""
    import serial
    try:
        with serial.Serial(port, 115200, timeout=0.1) as s:
            if reset:
                try:
                    s.dtr = False
                    s.rts = True
                    time.sleep(0.1)
                    s.rts = False
                    time.sleep(0.4)  # give the app a moment to come up
                except OSError:
                    pass
            try:
                s.reset_input_buffer()
            except OSError:
                pass
            s.write(f"{cmd}\n".encode())
            s.flush()
            buf = b""
            out = []
            deadline = time.time() + timeout
            while time.time() < deadline:
                data = s.read(s.in_waiting or 1)
                if not data:
                    continue
                buf += data
                while b"\n" in buf:
                    line, buf = buf.split(b"\n", 1)
                    m = CMD_RE.match(line.decode(errors="replace").rstrip("\r"))
                    if m:
                        out.append(m.group(1))
                        deadline = time.time() + 0.4  # keep reading while output flows
    except serial.SerialException as e:
        die(f"serial: {e}")
    for line in out:
        print(line)
    return 0 if out else 1

# --------------------------------------------------------------------------------------

def find_esptool():
    """Return an argv prefix that runs esptool, or None. Prefer the module form so a
    plain `pip install esptool` works; fall back to a script on PATH."""
    candidates = [[sys.executable, "-m", "esptool"]]
    for name in ("esptool.py", "esptool"):
        found = shutil.which(name)
        if found:
            candidates.append([found])
    for argv in candidates:
        try:
            r = subprocess.run(argv + ["version"], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            if r.returncode == 0:
                return argv
        except (OSError, subprocess.SubprocessError):
            continue
    return None

def esptool_major(esptool):
    """Best-effort major version of the esptool argv prefix (None if undetermined)."""
    try:
        r = subprocess.run(esptool + ["version"], capture_output=True, text=True, timeout=15)
        m = re.search(r"\bv?(\d+)\.\d+", r.stdout + "\n" + r.stderr)
        return int(m.group(1)) if m else None
    except (OSError, subprocess.SubprocessError, ValueError):
        return None

def load_flasher_args(build_dir):
    path = os.path.join(build_dir, "flasher_args.json")
    if not os.path.isfile(path):
        die(f"{path} not found — is {build_dir!r} an ESP-IDF build directory?")
    with open(path) as f:
        return json.load(f)

def do_flash(port, build_dir, baud):
    esptool = find_esptool()
    if not esptool:
        die("esptool not found — install it with:  pip install esptool  (this is not the IDF toolchain)")
    fa = load_flasher_args(build_dir)
    extra = fa.get("extra_esptool_args", {})
    chip = extra.get("chip", "esp32c3")
    # verify the referenced binaries are actually present before touching the chip
    files = fa["flash_files"]  # { "0xNNN": "relative/path.bin", ... }
    for rel in files.values():
        if not os.path.isfile(os.path.join(build_dir, rel)):
            die(f"missing binary {rel!r} in {build_dir} (rebuild, or --pull it from the build host)")
    # esptool v5 (ESP-IDF v6+) hyphenates its subcommands, option flags and reset
    # modes ("write-flash", "--flash-mode", "default-reset"); esptool v4 (the apt/pip
    # package) uses underscores. flasher_args.json is written in the BUILD's style, so
    # translate every arg to match whichever esptool we actually found on this box.
    v5 = (esptool_major(esptool) or 4) >= 5
    def flag(tok):        # option flag: translate the NAME only, keep the leading "--"
        if tok.startswith("--"):
            name = tok[2:]
            return "--" + (name.replace("_", "-") if v5 else name.replace("-", "_"))
        return tok        # values (dio, 2MB, 80m, 2MB-c1) pass through untouched
    def mode(key, dflt):  # a reset-mode VALUE
        s = extra.get(key, dflt)
        return s.replace("_", "-") if v5 else s.replace("-", "_")
    argv = list(esptool) + ["--chip", chip, "--port", port, "--baud", str(baud), "--before", mode("before", "default_reset"), "--after",  mode("after",  "hard_reset")]
    if extra.get("stub", True) is False:
        argv += ["--no-stub"]
    argv += ["write-flash" if v5 else "write_flash", *(flag(a) for a in fa.get("write_flash_args", []))]
    for offset in sorted(files, key=lambda o: int(o, 16)):
        argv += [offset, files[offset]]
    print(f"{CYAN}flash{RESET} chip={chip} port={port} dir={build_dir}")
    for offset in sorted(files, key=lambda o: int(o, 16)):
        print(f"       {offset:>8}  {files[offset]}")
    # esptool resolves the relative binary paths against cwd
    r = subprocess.run(argv, cwd=build_dir)
    if r.returncode != 0:
        die(f"esptool exited {r.returncode}")
    print(f"{COLORS['I']}flash complete{RESET}")

# --------------------------------------------------------------------------------------

def run_pull(remote, dest):
    """rsync the three flash binaries + flasher_args.json from a remote build dir into
    `dest`, preserving their relative subdirs. `remote` is host:/path/to/build."""
    if not shutil.which("rsync"):
        die("--pull needs rsync (and ssh) on this host")
    if ":" not in remote:
        die(f"--pull expects HOST:PATH, got {remote!r}")
    host, rpath = remote.split(":", 1)
    rpath = rpath.rstrip("/")
    os.makedirs(dest, exist_ok=True)
    def fetch(rel):
        local = os.path.join(dest, rel)
        os.makedirs(os.path.dirname(local) or ".", exist_ok=True)
        src = f"{host}:{rpath}/{rel}"
        print(f"{CYAN}pull{RESET} {src}")
        r = subprocess.run(["rsync", "-az", src, local])
        if r.returncode != 0:
            die(f"rsync failed for {src}")
    fetch("flasher_args.json")
    with open(os.path.join(dest, "flasher_args.json")) as f:
        fa = json.load(f)
    for rel in sorted(set(fa["flash_files"].values())):
        fetch(rel)
    return dest

def resolve_build_dir(args):
    if args.pull:
        # stage the pulled artifacts under the build dir (default ./_pulled)
        dest = args.build_dir if args.build_dir else os.path.join(os.getcwd(), "_pulled")
        return run_pull(args.pull, dest)
    return args.build_dir or "build"

# --------------------------------------------------------------------------------------

BLACKBOX_SECTOR = 4096
BLACKBOX_MAGIC = 0x42584F42   # 'BXOB', little-endian
BLACKBOX_HDR = 8              # magic(4) + seq(4)
PART_TABLE_OFFSET = 0x8000
PART_TABLE_SIZE = 0x1000
PART_ENTRY_MAGIC = 0x50AA
PART_ENTRY_SIZE = 32

def esptool_read(esptool, port, baud, offset, size, out_path):
    """Read a flash region to a file. NB this drives the chip into download mode, i.e. it RESETS the
    device; --after hard-reset restarts the app afterwards."""
    v5 = (esptool_major(esptool) or 4) >= 5
    argv = esptool + ["--port", port, "--baud", str(baud),
                      "--after", ("hard-reset" if v5 else "hard_reset"),
                      ("read-flash" if v5 else "read_flash"),
                      hex(offset), hex(size), out_path]
    verbose(" ".join(argv))
    r = subprocess.run(argv, stdout=(None if VERBOSE else subprocess.DEVNULL))
    return r.returncode == 0

def esptool_erase(esptool, port, baud, offset, size):
    """Erase a flash region (4 KB-aligned). Like the read, this RESETS the device."""
    v5 = (esptool_major(esptool) or 4) >= 5
    argv = esptool + ["--port", port, "--baud", str(baud),
                      "--after", ("hard-reset" if v5 else "hard_reset"),
                      ("erase-region" if v5 else "erase_region"),
                      hex(offset), hex(size)]
    verbose(" ".join(argv))
    r = subprocess.run(argv, stdout=(None if VERBOSE else subprocess.DEVNULL))
    return r.returncode == 0

def read_partition_table(esptool, port, baud):
    """Pull + parse the device's partition table. Returns [(label, ptype, subtype, offset, size)]."""
    tmp = os.path.join(tempfile.gettempdir(), f"esp32-tool-parttab-{os.getpid()}.bin")
    try:
        if not esptool_read(esptool, port, baud, PART_TABLE_OFFSET, PART_TABLE_SIZE, tmp):
            return []
        with open(tmp, "rb") as f:
            data = f.read()
    finally:
        try:
            os.unlink(tmp)
        except OSError:
            pass
    out = []
    for off in range(0, len(data) - PART_ENTRY_SIZE + 1, PART_ENTRY_SIZE):
        magic, ptype, subtype, poff, psize = struct.unpack_from("<HBBII", data, off)
        if magic != PART_ENTRY_MAGIC:
            break  # end of table
        label = data[off + 12 : off + 28].split(b"\0", 1)[0].decode("ascii", "replace")
        out.append((label, ptype, subtype, poff, psize))
    return out

def decode_blackbox_image(data):
    """Yield the CSV records held in a raw ESP_FLASH blackbox partition image, oldest first.

    Deliberately a STANDALONE copy of the walk rather than importing blackbox/py/blackbox_esp_flash.py:
    this tool must run on a bare target host with nothing but python3 + esptool, and must not depend on
    the blackbox repo being checked out beside it. The on-flash format is specified in that repo's
    DESIGN.md — if it ever changes, both decoders have to move together.

    Format: N x 4096-byte sectors used as a ring; each written sector starts [magic u32][seq u32],
    then records as [len u16][payload] (a CSV line, no newline). Sorting sectors by seq restores
    chronological order across the wrap. len 0xFFFF (erased) or 0 ends a sector.
    """
    sectors = []
    for off in range(0, (len(data) // BLACKBOX_SECTOR) * BLACKBOX_SECTOR, BLACKBOX_SECTOR):
        magic, seq = struct.unpack_from("<II", data, off)
        if magic == BLACKBOX_MAGIC:
            sectors.append((seq, off))
    sectors.sort()
    for _seq, off in sectors:
        end, pos = off + BLACKBOX_SECTOR, off + BLACKBOX_HDR
        while pos + 2 <= end:
            (length,) = struct.unpack_from("<H", data, pos)
            if length in (0xFFFF, 0) or pos + 2 + length > end:
                break
            yield data[pos + 2 : pos + 2 + length].decode("utf-8", "replace")
            pos += 2 + length
    return

def emit_records(data, out_path, stats_sectors=None):
    lines = list(decode_blackbox_image(data))
    if out_path:
        with open(out_path, "w") as f:
            for line in lines:
                f.write(line + "\n")
        print(f"{len(lines)} record(s) -> {out_path}", file=sys.stderr)
    else:
        for line in lines:
            print(line)
    if stats_sectors is not None:
        verbose(f"{len(lines)} record(s) from {stats_sectors} written sector(s)")
    return 0 if lines else 1

def do_diag_extract(port, partition, baud, raw_path, csv_path, offset=None, size=None):
    esptool = find_esptool()
    if not esptool:
        die("esptool not found — install it with:  pip install esptool  (this is not the IDF toolchain)")
    if offset is None or size is None:
        verbose("reading the partition table to locate the diagnostics partition")
        table = read_partition_table(esptool, port, baud)
        if not table:
            die("could not read the partition table (is the device attached and in a sane state?)")
        match = [e for e in table if e[0] == partition]
        if not match:
            names = ", ".join(e[0] for e in table) or "(none)"
            die(f"no partition named {partition!r} on this device; found: {names}")
        _, _, _, offset, size = match[0]
        verbose(f"partition {partition!r} at {offset:#x}, {size} bytes")
    keep = raw_path or os.path.join(tempfile.gettempdir(), f"esp32-tool-diag-{os.getpid()}.bin")
    # progress goes to stderr so `diag extract` with no --out can be piped as clean CSV
    print(f"reading {partition} ({size} bytes at {offset:#x}) from {port} — this resets the device", file=sys.stderr)
    try:
        if not esptool_read(esptool, port, baud, offset, size, keep):
            die("esptool read-flash failed")
        with open(keep, "rb") as f:
            data = f.read()
        if raw_path:
            print(f"raw image -> {raw_path}", file=sys.stderr)
        return emit_records(data, csv_path)
    finally:
        if not raw_path:
            try:
                os.unlink(keep)
            except OSError:
                pass

def do_diag_clear(port, partition, baud, offset, size, confirm):
    """Erase the diagnostics partition. The firmware re-lays a fresh log on its next boot (the
    backend treats an all-0xFF partition as virgin), and --after hard-reset restarts it for us."""
    if not confirm:
        die("diag clear ERASES the partition (weeks of field records) — re-run with --confirm.\n"
            "       You probably want `diag extract` first.")
    esptool = find_esptool()
    if not esptool:
        die("esptool not found — install it with:  pip install esptool  (this is not the IDF toolchain)")
    if offset is None or size is None:
        table = read_partition_table(esptool, port, baud)
        if not table:
            die("could not read the partition table (is the device attached and in a sane state?)")
        match = [e for e in table if e[0] == partition]
        if not match:
            names = ", ".join(e[0] for e in table) or "(none)"
            die(f"no partition named {partition!r} on this device; found: {names}")
        _, _, _, offset, size = match[0]
    print(f"erasing {partition} ({size} bytes at {offset:#x}) on {port} — this resets the device", file=sys.stderr)
    if not esptool_erase(esptool, port, baud, offset, size):
        die("esptool erase-region failed")
    print(f"{partition} erased", file=sys.stderr)
    return 0

def do_diag_decode(image_path, csv_path):
    try:
        with open(image_path, "rb") as f:
            data = f.read()
    except OSError as e:
        die(str(e))
    return emit_records(data, csv_path)

# --------------------------------------------------------------------------------------

def main():
    parser = argparse.ArgumentParser(
        prog="esp32-tool",
        description="Flash, monitor, drive and diagnose an ESP32 over USB serial (no IDF toolchain).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__,
    )
    sub = parser.add_subparsers(dest="cmd", required=True)
    def add_common(p, build=False):
        p.add_argument("-p", "--port", default=os.environ.get("ESP32_PORT", "/dev/ttyACM0"), help="serial port (default: $ESP32_PORT or /dev/ttyACM0)")
        # -w is the answer to a board that deep-sleeps: it is only enumerated for a few seconds per
        # cycle, so "not found" is usually "not awake yet" rather than "not plugged in".
        p.add_argument("-w", "--wait", action="store_true", help="wait for the port to appear instead of failing (for a board that sleeps between cycles)")
        if build:
            p.add_argument("-b", "--build-dir", default=None, help="ESP-IDF build directory (default: ./build, or the --pull staging dir)")
            p.add_argument("--pull", metavar="HOST:PATH", default=None, help="rsync the build's binaries from a remote build dir first")
            p.add_argument("--baud", type=int, default=460800, help="flash baud (ignored on USB-JTAG)")
    p_flash = sub.add_parser("flash", help="write a build dir to the chip")
    add_common(p_flash, build=True)
    p_mon = sub.add_parser("monitor", help="print the serial console (interactive; -r resets first)")
    add_common(p_mon)
    p_mon.add_argument("-r", "--reset", action="store_true", help="reset the device on connect (off by default)")
    p_mon.add_argument("command", nargs="?", default=None, help="command string to inject after boot")
    p_dep = sub.add_parser("deploy", help="flash, then monitor")
    add_common(p_dep, build=True)
    p_dep.add_argument("command", nargs="?", default=None, help="command string to inject after boot")
    p_diag = sub.add_parser("diag", help="pull + decode the blackbox diagnostics partition")
    add_common(p_diag)
    p_diag.add_argument("action", choices=["extract", "decode", "clear"], help="extract = read from the device; decode = an already-pulled image; clear = erase the partition")
    p_diag.add_argument("image", nargs="?", default=None, help="decode: the raw partition image to read")
    p_diag.add_argument("--partition", default="diag", help="partition name to read (default: diag)")
    p_diag.add_argument("--offset", type=lambda v: int(v, 0), default=None, help="skip the partition-table lookup (needs --size)")
    p_diag.add_argument("--size", type=lambda v: int(v, 0), default=None, help="bytes to read (with --offset)")
    p_diag.add_argument("--raw", default=None, help="also keep the raw partition image at this path")
    p_diag.add_argument("--out", default=None, help="write the decoded CSV here (default: stdout)")
    p_diag.add_argument("--baud", type=int, default=460800, help="read baud (default 460800)")
    p_diag.add_argument("--verbose", "-v", action="store_true", help="show the esptool invocation and partition lookup")
    p_diag.add_argument("--confirm", action="store_true", help="required by `diag clear`: yes, really erase it")
    p_cmd = sub.add_parser("command", help="issue one command to a running device and print its response")
    add_common(p_cmd)
    p_cmd.add_argument("-r", "--reset", action="store_true", help="reset the device before issuing (off by default)")
    p_cmd.add_argument("--timeout", type=float, default=2.0, help="seconds to wait for the response (default 2.0)")
    p_cmd.add_argument("request", nargs="+", help="the command to send, e.g. 'vers', or 'logl debug'")

    args = parser.parse_args()
    if args.cmd == "flash":
        build = resolve_build_dir(args)  # resolve (and --pull) BEFORE waiting, so the window is spent flashing
        require_port(args)
        do_flash(args.port, build, args.baud)
        return
    if args.cmd == "monitor":
        require_port(args)
        try:
            monitor(args.port, args.command, reset=args.reset)
        except KeyboardInterrupt:
            print()
        return
    if args.cmd == "diag":
        global VERBOSE
        VERBOSE = args.verbose
        if args.action == "decode":
            if not args.image:
                die("diag decode needs an image file (e.g. esp32-tool diag decode diag.bin)")
            sys.exit(do_diag_decode(args.image, args.out))
        require_port(args)
        if (args.offset is None) != (args.size is None):
            die("--offset and --size must be given together")
        if args.action == "clear":
            sys.exit(do_diag_clear(args.port, args.partition, args.baud, args.offset, args.size, args.confirm))
        try:
            sys.exit(do_diag_extract(args.port, args.partition, args.baud, args.raw, args.out, args.offset, args.size))
        except KeyboardInterrupt:
            print()
            sys.exit(130)
    if args.cmd == "command":
        require_port(args)
        try:
            sys.exit(command_oneshot(args.port, " ".join(args.request), reset=args.reset, timeout=args.timeout))
        except KeyboardInterrupt:
            print()
            sys.exit(130)
        return
    if args.cmd == "deploy":
        build = resolve_build_dir(args)  # resolve (and --pull) BEFORE waiting, so the window is spent flashing
        require_port(args)
        do_flash(args.port, build, args.baud)
        # esptool's --after hard_reset already restarted the app; monitor picks it up
        # (its own reconnect handles the USB-JTAG re-enumeration a reset can cause).
        try:
            monitor(args.port, args.command, reset=False)
        except KeyboardInterrupt:
            print()
        return

if __name__ == "__main__":
    main()

