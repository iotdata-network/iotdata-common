#!/usr/bin/env node
'use strict';

// dialout-server -- the far end of dialout: a small dedicated sshd that field boxes call home to,
// plus the DNS and UPnP that let them find it.
//
// It does four things and no more:
//
//   * runs dropbear on one port, for one purpose, with one account that has no shell. It is not
//     the host's sshd and shares nothing with it -- its own host key, its own authorized_keys,
//     local forwarding disabled, root login disabled. A stolen client key gets a tunnel and
//     nothing else.
//   * keeps a UPnP mapping alive for that port, if the server is itself behind a router.
//   * publishes where it is, in DNS via Cloudflare: an A record for the address and an SRV record
//     carrying the port, so a client needs only the domain to find the whole endpoint.
//   * publishes WHO IT WANTS, as a TXT invite list. This is the bit that makes the whole thing
//     cheap: a client with no invite does two DNS lookups and goes back to sleep, so the normal
//     state of the fleet costs nothing at either end.
//
// `run` is meant to be run in a terminal as much as under systemd -- same code path, logs to
// stdout either way. The systemd unit is a convenience, not the supported way in.
//
// The usual session is one command:
//
//   dialout-server wait --for iotdata-tst-2
//
// which invites that client, waits for its tunnel to appear, rings the terminal bell, tells you
// the ssh line to paste, and withdraws the invitation when you Ctrl-C out.
//
// Clients are named after their MAC, which is exactly what you want for a token and exactly what you
// do not want to read or type. So give a box a tag and use that instead -- anywhere a client is
// named, including `wait --for`, an unambiguous fragment of the tag or of the name will do:
//
//   dialout-server tag iotdata-rem-50411c64b8fc solar shed, Brannan
//   dialout-server wait --for "solar shed"
//   dialout-server clients                      # the tag is a column
//
// The tag is stored in the comment field of the client's authorized_keys line, because that file is
// already the register of who is enrolled and a second list would only drift from it. It is operator
// sugar and nothing more: tokens and ports still derive from the real name, so a tag can be changed
// or dropped at any time without a client noticing.
//
// Moving it, or standing up a second one: `backup` tars the state (host key, the authorized_keys
// register with its tags, invites, liveness stamps) and the config, and `restore` puts it back on
// another box. The host key is the point -- clients pin it, so both ends must present the same one.
//
// Node with no dependencies: it shells out to curl, upnpc, dropbear, ss and dig, the same way
// iotdata's own lib/iotdata-network.js does. Nothing here imports iotdata -- dialout stands alone,
// and only reads iotdata.conf as a convenience if you point it at one.

const { execFileSync, spawn } = require('child_process');
const crypto = require('crypto');
const fs = require('fs');
const os = require('os');
const path = require('path');

const SELF = path.basename(process.argv[1] || 'dialout-server');
const HERE = path.dirname(fs.realpathSync(process.argv[1]));
const IPIFY = 'https://api.ipify.org';
const CF_API = 'https://api.cloudflare.com/client/v4';

// ------------------------------------------------------------------------------------------------
// config -- same file, same rules as the client
// ------------------------------------------------------------------------------------------------

function cfgParse(file, into) {
    if (!fs.existsSync(file)) return into;
    for (const line of fs.readFileSync(file, 'utf8').split('\n')) {
        const t = line.trim();
        if (!t || t.startsWith('#')) continue;
        const i = t.indexOf('=');
        if (i < 0) continue;
        into[t.slice(0, i).trim()] = t.slice(i + 1).trim();
    }
    return into;
}

// One file is the whole configuration: dialout.<hostname>.cfg beside the script, or --config. The
// committed dialout.cfg is the documented template that file is copied from, and is never read at
// run time -- so what a box does can be read off a single file, with nothing inherited from a
// baseline that may have moved on since. No host file means the built-in defaults and nothing else;
// whatever needs a domain or a token then says which file to create.
const hostCfg = () => path.join(HERE, `dialout.${os.hostname()}.cfg`);
let CFG_FILE = null;
const cfgHint = () => (CFG_FILE ? `in ${CFG_FILE}` : `-- there is no ${hostCfg()}: copy dialout.cfg to it and fill it in`);

function cfgLoad(explicit) {
    const c = {};
    CFG_FILE = explicit || (fs.existsSync(hostCfg()) ? hostCfg() : null);
    if (CFG_FILE) cfgParse(CFG_FILE, c);
    // Cloudflare credentials may live in an iotdata.conf on a box that already has one. Convenience
    // only -- dialout works with no iotdata present, and blanking iotdata-conf severs the link.
    if (!c['cloudflare-token'] && c['iotdata-conf'] && fs.existsSync(c['iotdata-conf'])) {
        const i = cfgParse(c['iotdata-conf'], {});
        c['cloudflare-token'] = c['cloudflare-token'] || i['network-dns-cloudflare-key'] || '';
        c['cloudflare-zone'] = c['cloudflare-zone'] || i['network-dns-cloudflare-zone'] || '';
        c['dns-domain'] = c['dns-domain'] || i['domain'] || '';
    }
    return c;
}

let CFG = {};
const cfg = (k, d) => (CFG[k] !== undefined && CFG[k] !== '' ? CFG[k] : d);
const cfgN = (k, d) => parseInt(cfg(k, d), 10);

const ts = () => new Date().toISOString().replace(/\.\d+Z$/, 'Z');
const log = (...a) => console.log(ts(), ...a);
const warn = (...a) => console.log(ts(), 'WARN', ...a);
const die = (m) => {
    console.error(`${SELF}: ${m}`);
    process.exit(1);
};

function run(file, args, opts = {}) {
    return execFileSync(file, args, { stdio: ['ignore', 'pipe', 'pipe'], timeout: 30000, ...opts })
        .toString()
        .trim();
}
// upnpc prints its errors to stdout, not stderr, so a failure looks like success unless both are read.
const errText = (e) =>
    [e.stderr, e.stdout]
        .map((b) => (b ? b.toString().trim() : ''))
        .filter(Boolean)
        .join(' -- ') || e.message;
const have = (bin) => {
    try {
        execFileSync('sh', ['-c', `command -v ${bin}`], { stdio: 'ignore' });
        return true;
    } catch {
        return false;
    }
};

// ------------------------------------------------------------------------------------------------
// identity -- must agree with dialout-client, byte for byte
// ------------------------------------------------------------------------------------------------

const tokenOf = (name) => crypto.createHash('md5').update(name).digest('hex').slice(0, 6);
const portOf = (name) => cfgN('tunnel-port-base', 47100) + (parseInt(tokenOf(name), 16) % cfgN('tunnel-port-span', 400));

const dnsDomain = () => cfg('dns-domain', '') || die(`dns-domain is not set ${cfgHint()}`);
const dnsTarget = () => cfg('dns-target', '') || `${cfg('dns-service', 'dialout')}.${dnsDomain()}`;
const srvName = () => `_${cfg('dns-service', 'dialout')}._tcp.${dnsDomain()}`;
const inviteName = () => cfg('dns-invite', '') || `_${cfg('dns-service', 'dialout')}-invite._tcp.${dnsDomain()}`;

// ------------------------------------------------------------------------------------------------
// state
// ------------------------------------------------------------------------------------------------

const stateDir = () => cfg('state-dir', '/var/lib/dialout');
const homeDir = () => path.join(stateDir(), 'home');
const authKeys = () => path.join(homeDir(), '.ssh', 'authorized_keys');
// One file per client, last-write-wins, no locking: a stamp is worth exactly its timestamp, and two
// pings racing means the box is alive twice over.
const seenDir = () => path.join(stateDir(), 'seen');
const seenPath = (name) => path.join(seenDir(), name);
const seenCmd = (dst) => `${path.join(dst, 'dialout-seen')} ${seenDir()}`;

function seenStamp(name) {
    try {
        fs.mkdirSync(seenDir(), { recursive: true, mode: 0o700 });
        const now = Math.floor(Date.now() / 1000);
        const tmp = path.join(seenDir(), `.${name}.${process.pid}`);
        fs.writeFileSync(tmp, `${now} ${ts()} -\n`);
        fs.renameSync(tmp, seenPath(name));
    } catch {
        /* monitoring is not worth failing a tunnel over */
    }
}
function seenAt(name) {
    try {
        return parseInt(fs.readFileSync(seenPath(name), 'utf8').split(/\s+/)[0], 10) || 0;
    } catch {
        return 0;
    }
}
const ago = (t) => {
    if (!t) return '-';
    const d = Math.max(0, Math.floor(Date.now() / 1000) - t);
    if (d < 60) return `${d}s`;
    if (d < 3600) return `${Math.floor(d / 60)}m`;
    if (d < 86400) return `${Math.floor(d / 3600)}h${String(Math.floor((d % 3600) / 60)).padStart(2, '0')}m`;
    return `${Math.floor(d / 86400)}d${String(Math.floor((d % 86400) / 3600)).padStart(2, '0')}h`;
};
const hostKey = () => path.join(stateDir(), 'host_key');
const inviteFile = () => path.join(stateDir(), 'invites.json');

const readInvites = () => {
    try {
        return JSON.parse(fs.readFileSync(inviteFile(), 'utf8'));
    } catch {
        return {};
    }
};
const writeInvites = (v) => {
    fs.mkdirSync(stateDir(), { recursive: true });
    const tmp = `${inviteFile()}.tmp`; // rename, so a backup or a power cut cannot catch it half-written
    fs.writeFileSync(tmp, JSON.stringify(v, null, 2) + '\n');
    fs.renameSync(tmp, inviteFile());
};

// enrolled clients, read back out of authorized_keys -- the keys file IS the register, so there is
// no second list to drift out of step with it.
function clients() {
    if (!fs.existsSync(authKeys())) return [];
    return fs
        .readFileSync(authKeys(), 'utf8')
        .split('\n')
        .map((l) => l.trim())
        .filter((l) => l && !l.startsWith('#'))
        .map((l) => {
            const m = /dialout:(\S+)\s*$/.exec(l);
            const name = m ? m[1] : '(unnamed)';
            // The tag sits in the comment field BEFORE dialout:<name>, so the name regex above is
            // unaffected and an older keys file simply has no tag. Same register, no second file.
            const t = /\btag="([^"]*)"/.exec(l);
            return { name, tag: t ? t[1] : '', token: tokenOf(name), port: portOf(name), line: l };
        });
}

// Rewrite one client's tag in place. The keys file is the register, so the tag lives there too and a
// revoke takes it away for free -- but it is also the file that decides who may log in, so this only
// ever touches the comment field of the one line, and writes through a rename.
function setTag(name, tag) {
    const cs = clients();
    if (!cs.some((c) => c.name === name)) die(`tag: '${name}' is not enrolled`);
    const clean = tag.replace(/["\r\n]/g, '').trim(); // it is stored in a quoted field
    const out = cs.map((c) => {
        if (c.name !== name) return c.line;
        const bare = c.line.replace(/\s*\btag="[^"]*"/, '');
        return clean ? bare.replace(/(\s*dialout:\S+\s*)$/, ` tag="${clean}"$1`) : bare;
    });
    const tmp = `${authKeys()}.tmp`;
    fs.writeFileSync(tmp, out.join('\n') + '\n', { mode: 0o600 });
    fs.renameSync(tmp, authKeys());
    chownState();
    return clean;
}

// A box called iotdata-rem-50411c64b8fc is not something anyone wants to type, or recognise in a
// list. So every command that names a client also takes its tag, or any unambiguous fragment of
// either. Resolution happens HERE and nowhere else: downstream code only ever sees a real name, and
// the token is still derived from that name, so an alias stays an operator convenience and never
// becomes part of the protocol.
function resolveName(arg, verb) {
    if (!arg || arg === '*') return arg;
    const cs = clients();
    if (cs.some((c) => c.name === arg)) return arg;
    const lc = arg.toLowerCase();
    let hits = cs.filter((c) => c.tag && c.tag.toLowerCase() === lc);
    if (!hits.length) hits = cs.filter((c) => c.name.toLowerCase().includes(lc) || (c.tag && c.tag.toLowerCase().includes(lc)));
    if (hits.length === 1) {
        log(`${verb}: '${arg}' -> ${hits[0].name}${hits[0].tag ? ` (${hits[0].tag})` : ''}`);
        return hits[0].name;
    }
    if (hits.length > 1) die(`${verb}: '${arg}' matches ${hits.map((c) => c.name).join(', ')} -- be more specific`);
    // Not enrolled and not a tag: pass it through. Inviting a box before enrolling it is legitimate,
    // and a token derives from any string, so this must not become an error.
    return arg;
}

// which of those tunnels are up right now: dropbear binds a forwarded port on loopback, so the
// listening socket is the presence signal. Nothing to poll the client for.
function listening() {
    try {
        const out = run('ss', ['-ltnH']);
        const ports = new Set();
        for (const l of out.split('\n')) {
            const m = /127\.0\.0\.1:(\d+)/.exec(l);
            if (m) ports.add(+m[1]);
        }
        return ports;
    } catch {
        return new Set();
    }
}

// ------------------------------------------------------------------------------------------------
// Cloudflare
// ------------------------------------------------------------------------------------------------

function cfApi(method, pathPart, body) {
    const token = cfg('cloudflare-token', '') || die(`cloudflare-token is not set ${cfgHint()}`);
    const args = ['-s', '--max-time', '25', '-X', method, '-H', `Authorization: Bearer ${token}`, '-H', 'Content-Type: application/json', `${CF_API}${pathPart}`];
    if (body) args.push('--data', JSON.stringify(body));
    let json;
    try {
        json = JSON.parse(run('curl', args));
    } catch {
        throw new Error('cloudflare: non-JSON / no response');
    }
    if (!json.success) throw new Error(`cloudflare: ${(json.errors || []).map((e) => e.message).join('; ') || 'request failed'}`);
    return json.result;
}

let ZONE = null;
function zoneId() {
    if (ZONE) return ZONE;
    const z = cfg('cloudflare-zone', '') || die('cloudflare-zone is not set');
    // a 32-hex string is already an id; anything else is a name to look up (token needs Zone:Read)
    if (/^[0-9a-f]{32}$/i.test(z)) return (ZONE = z);
    const res = cfApi('GET', `/zones?name=${encodeURIComponent(z)}`);
    if (!res || !res.length) throw new Error(`cloudflare: zone '${z}' not visible to this token`);
    return (ZONE = res[0].id);
}

const recFind = (type, name) => {
    const r = cfApi('GET', `/zones/${zoneId()}/dns_records?type=${type}&name=${encodeURIComponent(name)}`);
    return (r && r[0]) || null;
};

// create / update / leave alone. Returns what it did, so the reconcile loop can stay quiet when
// there is nothing to say -- a log line every 5 minutes saying "unchanged" is a log nobody reads.
function recReconcile(type, name, body, same) {
    const ttl = cfgN('dns-ttl', 60);
    const rec = recFind(type, name);
    if (!rec) {
        cfApi('POST', `/zones/${zoneId()}/dns_records`, { type, name, ttl, proxied: false, ...body });
        return 'created';
    }
    if (same(rec)) return 'unchanged';
    cfApi('PUT', `/zones/${zoneId()}/dns_records/${rec.id}`, { type, name, ttl, proxied: false, ...body });
    return 'updated';
}

const publishA = (ip) => recReconcile('A', dnsTarget(), { content: ip }, (r) => r.content === ip);

const publishSrv = (port) =>
    recReconcile(
        'SRV',
        srvName(),
        { data: { service: `_${cfg('dns-service', 'dialout')}`, proto: '_tcp', name: dnsDomain(), priority: 0, weight: 0, port, target: dnsTarget() } },
        (r) => r.data && r.data.port === port && String(r.data.target).replace(/\.$/, '') === dnsTarget()
    );

// The invite list, rendered from state. Tokens rather than names: this record is world-readable,
// and a public roll-call of your field sites is nobody else's business.
function renderInvites(inv) {
    const now = Math.floor(Date.now() / 1000);
    const live = Object.entries(inv).filter(([, e]) => !e.expires || e.expires > now);
    return 'v=1' + live.map(([tok, e]) => ` ${tok}${e.expires ? ':' + e.expires : ''}`).join('');
}

const publishInvites = (inv) => {
    const content = renderInvites(inv);
    if (content.length > 250) warn(`invite list is ${content.length} chars -- a TXT string caps at 255`);
    return recReconcile('TXT', inviteName(), { content }, (r) => r.content === content);
};

// ------------------------------------------------------------------------------------------------
// public IP + UPnP
// ------------------------------------------------------------------------------------------------

function publicIp() {
    try {
        const ip = run('curl', ['-s', '--max-time', '15', IPIFY]);
        return /^\d{1,3}(\.\d{1,3}){3}$/.test(ip) ? ip : null;
    } catch {
        return null;
    }
}

function localIp() {
    try {
        const out = run('sh', ['-c', "ip route get 1.1.1.1 2>/dev/null | sed -n 's/.*src \\([0-9.]*\\).*/\\1/p' | head -1"]);
        return /^\d{1,3}(\.\d{1,3}){3}$/.test(out) ? out : null;
    } catch {
        return null;
    }
}

// idempotent: re-adding an existing mapping refreshes its lease, which is the point of doing this
// on a timer rather than once at startup.
function upnpAssert() {
    const lip = localIp();
    if (!lip) return { ok: false, message: 'could not determine local IP' };
    if (!have('upnpc')) return { ok: false, message: 'upnpc not found -- apt install miniupnpc' };
    try {
        const out = run('upnpc', ['-e', 'dialout', '-a', lip, String(cfgN('port-internal', 47022)), String(cfgN('port-external', 47022)), 'TCP']);
        const ext = (out.match(/ExternalIPAddress\s*=\s*([0-9.]+)/) || [])[1];
        return { ok: true, message: `mapped ${lip}:${cfg('port-internal', 47022)} -> ${ext || '?'}:${cfg('port-external', 47022)}`, externalIp: ext };
    } catch (e) {
        return { ok: false, message: errText(e) };
    }
}

// ------------------------------------------------------------------------------------------------
// dropbear
// ------------------------------------------------------------------------------------------------

function ensureHostKey() {
    fs.mkdirSync(stateDir(), { recursive: true });
    if (fs.existsSync(hostKey())) return false;
    if (!have('dropbearkey')) die('dropbearkey not found -- apt install dropbear-bin');
    run('dropbearkey', ['-t', 'ed25519', '-f', hostKey()]);
    log(`host key created: ${hostKey()}`);
    return true;
}

function hostKeyFingerprint() {
    try {
        const out = run('dropbearkey', ['-y', '-f', hostKey()]);
        return (out.match(/Fingerprint:\s*(\S+)/) || [])[1] || null;
    } catch {
        return null;
    }
}

// -j disables LOCAL forwarding, so a client key cannot be used to reach into this server's LAN.
// Remote forwarding stays on -- that is the entire feature. No -a, so forwarded ports bind to
// loopback only and you have to be on this box (or through its own sshd) to use them.
function dropbearArgs() {
    return ['-F', '-E', '-s', '-g', '-w', '-j', '-p', `${cfg('bind', '0.0.0.0')}:${cfgN('port-internal', 47022)}`, '-r', hostKey()];
}

function spawnDropbear() {
    if (!have('dropbear')) die('dropbear not found -- apt install dropbear-bin');
    const p = spawn('dropbear', dropbearArgs(), { stdio: ['ignore', 'pipe', 'pipe'] });
    const pipe = (s, tag) =>
        s.on('data', (b) =>
            b
                .toString()
                .split('\n')
                .filter(Boolean)
                .forEach((l) => log(tag, l))
        );
    pipe(p.stdout, 'sshd');
    pipe(p.stderr, 'sshd');
    return p;
}

// ------------------------------------------------------------------------------------------------
// actions
// ------------------------------------------------------------------------------------------------

function actionEnrol(argv) {
    let tag = '';
    const pos = [];
    for (let i = 0; i < argv.length; i++) {
        if (argv[i] === '--tag') tag = argv[++i] || die('enrol: --tag needs some text');
        else pos.push(argv[i]);
    }
    const name = pos[0] || die('enrol: need a client name');
    const src = pos[1] || '-';
    const key = (src === '-' ? fs.readFileSync(0, 'utf8') : fs.readFileSync(src, 'utf8')).trim();
    if (!/^(ssh-ed25519|ssh-rsa|ecdsa-)/.test(key)) die('enrol: that does not look like an ssh public key');
    fs.mkdirSync(path.dirname(authKeys()), { recursive: true, mode: 0o700 });
    const existing = clients();
    if (existing.some((c) => c.name === name)) die(`enrol: '${name}' is already enrolled (revoke it first)`);
    const clash = existing.find((c) => c.port === portOf(name));
    if (clash) warn(`'${name}' derives the same port ${portOf(name)} as '${clash.name}' -- pin one with tunnel-port=`);
    // Options, not `restrict`: dropbear does not implement the OpenSSH 7.2 keyword. With -N the
    // client asks for no session at all, so command= is belt to -w's braces -- and on the one path
    // that DOES open a session, the client's liveness ping, the forced command records it.
    const opts = `no-pty,no-agent-forwarding,no-X11-forwarding,command="${seenCmd(cfg('install-dir', '/usr/local/lib/dialout'))} ${name}"`;
    fs.appendFileSync(authKeys(), `${opts} ${key.split(/\s+/).slice(0, 2).join(' ')} dialout:${name}\n`, { mode: 0o600 });
    fs.chmodSync(authKeys(), 0o600);
    chownState();
    log(`enrolled ${name}: token ${tokenOf(name)}, tunnel port ${portOf(name)}`);
    if (tag) log(`tagged ${name}: ${setTag(name, tag)}`);
}

function actionTag(argv) {
    const who = argv[0] || die('tag: need a client (name, tag or fragment), then the text -- or no text to clear it');
    const name = resolveName(who, 'tag');
    const text = argv.slice(1).join(' ');
    const clean = setTag(name, text);
    log(clean ? `tagged ${name}: ${clean}` : `cleared the tag on ${name}`);
}

function actionRevoke(argv) {
    // (the stamp for this name is removed at the end, once the key is actually gone)
    const name = resolveName(argv[0] || die('revoke: need a client (name, tag or fragment)'), 'revoke');
    const kept = clients().filter((c) => c.name !== name);
    if (kept.length === clients().length) die(`revoke: '${name}' is not enrolled`);
    fs.writeFileSync(authKeys(), kept.map((c) => c.line).join('\n') + (kept.length ? '\n' : ''), { mode: 0o600 });
    const inv = readInvites();
    delete inv[tokenOf(name)];
    writeInvites(inv);
    fs.rmSync(seenPath(name), { force: true }); // no stale "last seen" for a client that is gone
    log(`revoked ${name}`);
}

function actionClients() {
    const up = listening();
    const cs = clients();
    if (!cs.length) return console.log('(none enrolled)');
    const inv = readInvites();
    const now = Math.floor(Date.now() / 1000);
    // the names are 24 characters of MAC address, so measure the column instead of guessing at it
    const w = Math.max(4, ...cs.map((c) => c.name.length));
    console.log(`${'NAME'.padEnd(w)}  TOKEN   PORT   INVITED  TUNNEL  LAST SEEN  TAG`);
    for (const c of cs) {
        const e = inv[c.token] || inv['*'];
        const invited = e && (!e.expires || e.expires > now) ? (e.expires ? `${e.expires - now}s` : 'yes') : 'no';
        const t = up.has(c.port) ? 'UP' : '-';
        console.log(
            `${c.name.padEnd(w)}  ${c.token}  ${String(c.port).padEnd(6)} ${invited.padEnd(8)} ${t.padEnd(7)} ${ago(seenAt(c.name)).padEnd(10)} ${c.tag}`
        );
    }
    const seen = new Map();
    for (const c of cs) {
        if (seen.has(c.port)) warn(`port ${c.port} is derived by both '${seen.get(c.port)}' and '${c.name}'`);
        seen.set(c.port, c.name);
    }
}

function actionInvite(argv) {
    const who = resolveName(argv[0] || die('invite: need a client (name, tag or fragment), or * for everyone'), 'invite');
    let ttl = 0;
    for (let i = 1; i < argv.length; i++) if (argv[i] === '--ttl') ttl = parseInt(argv[++i], 10);
    const tok = who === '*' ? '*' : tokenOf(who);
    const inv = readInvites();
    inv[tok] = { name: who, expires: ttl ? Math.floor(Date.now() / 1000) + ttl : 0 };
    writeInvites(inv);
    const action = publishInvites(inv);
    log(`invited ${who} (${tok})${ttl ? ` for ${ttl}s` : ''} -- TXT ${action}`);
}

function actionUninvite(argv) {
    const who = resolveName(argv[0] || die('uninvite: need a client (name, tag or fragment), or * '), 'uninvite');
    const tok = who === '*' ? '*' : tokenOf(who);
    const inv = readInvites();
    if (!(tok in inv)) log(`${who} was not invited`);
    delete inv[tok];
    writeInvites(inv);
    log(`uninvited ${who} (${tok}) -- TXT ${publishInvites(inv)}`);
}

// The screen-session workflow: invite, wait, ring the bell, hand over the ssh line, and withdraw
// the invitation on the way out so a box cannot keep dialling in for a session that ended weeks ago.
function actionWait(argv) {
    let name = null,
        ttl = 0,
        keep = false;
    for (let i = 0; i < argv.length; i++) {
        if (argv[i] === '--for' || argv[i] === '--wait-for') name = argv[++i];
        else if (argv[i] === '--ttl') ttl = parseInt(argv[++i], 10);
        else if (argv[i] === '--keep') keep = true;
        else if (!name) name = argv[i];
    }
    if (!name) die('wait: need --for <client> (a name, tag or fragment of either)');
    name = resolveName(name, 'wait');
    const port = portOf(name);
    actionInvite(ttl ? [name, '--ttl', String(ttl)] : [name]);

    process.on('SIGINT', () => {
        console.log('');
        if (keep) {
            log(`leaving the invitation in place (--keep) -- withdraw it with: ${SELF} uninvite ${name}`);
            process.exit(0);
        }
        try {
            actionUninvite([name]);
        } catch (e) {
            warn(`could not withdraw invite: ${e.message}`);
        }
        process.exit(0);
    });

    log(`waiting for ${name} (token ${tokenOf(name)}) on port ${port}`);
    // Ctrl-C withdraws, and withdrawing is what tells the client to hang up -- so this window is
    // meant to be LEFT RUNNING while you work, not dismissed once the bell goes. Say so plainly:
    // the natural reflex on seeing "IS UP" is to Ctrl-C and then ssh in, which would pull the
    // tunnel out from under you. --keep is the escape hatch for exactly that.
    log(keep ? 'Ctrl-C stops watching and LEAVES the invitation in place (--keep)' : 'Ctrl-C withdraws the invitation, which hangs the client up -- leave this running while you work');
    let wasUp = false;
    const tick = () => {
        const up = listening().has(port);
        if (up && !wasUp) {
            process.stdout.write('\x07'); // the bell -- the whole point of sitting in a screen session
            log(`*** ${name} IS UP ***`);
            console.log('');
            console.log(`    ssh -p ${port} <user>@127.0.0.1        # from this host`);
            console.log('');
            if (!keep) console.log('    (keep this window open -- Ctrl-C here hangs the tunnel up)');
            console.log('');
        } else if (!up && wasUp) log(`${name} went away`);
        wasUp = up;
    };
    tick();
    setInterval(tick, 5000);
}

function actionStatus() {
    const up = listening();
    console.log(`config        ${CFG_FILE || `(none -- built-in defaults; copy dialout.cfg to ${hostCfg()})`}`);
    console.log(`state dir     ${stateDir()}`);
    console.log(`host key      ${fs.existsSync(hostKey()) ? hostKeyFingerprint() || hostKey() : '(none -- run keygen)'}`);
    console.log(`listen        ${cfg('bind', '0.0.0.0')}:${cfg('port-internal', 47022)}  (external ${cfg('port-external', 47022)})`);
    console.log(`sshd          ${up.has(cfgN('port-internal', 47022)) || listeningAny(cfgN('port-internal', 47022)) ? 'running' : 'not running'}`);
    if (cfg('dns-domain', '')) {
        console.log(`srv           ${srvName()}`);
        console.log(`target        ${dnsTarget()}`);
        console.log(`invites       ${inviteName()}  ->  ${renderInvites(readInvites())}`);
    } else console.log('dns           (dns-domain not set)');
    const pub = publicIp();
    console.log(`seen dir      ${seenDir()}`);
    console.log(`public ip     ${pub || '(unknown)'}`);
    console.log('');
    actionClients();
}

// listening() only collects loopback; the sshd itself binds elsewhere, so ask separately.
function listeningAny(port) {
    try {
        return new RegExp(`:${port}\\s`).test(run('ss', ['-ltnH']));
    } catch {
        return false;
    }
}

function chownState() {
    const user = cfg('ssh-user', 'dialoutd');
    try {
        run('chown', ['-R', `${user}:${user}`, homeDir()]);
        run('chmod', ['700', homeDir(), path.dirname(authKeys())]);
        // The state dir itself must be TRAVERSABLE by that account: dropbear drops to its uid
        // before reading ~/.ssh/authorized_keys, and a 0700 root-owned parent anywhere up the path
        // fails the read silently -- the log says only "Exit before auth ... 0 fails", which looks
        // exactly like a wrong key. Cost an hour once; hence the explicit chmod.
        run('chmod', ['755', stateDir()]);
        // the liveness ping runs as this account (see dialout-seen), so the stamps are its to write
        fs.mkdirSync(seenDir(), { recursive: true, mode: 0o700 });
        run('chown', ['-R', `${user}:${user}`, seenDir()]);
        run('chmod', ['700', seenDir()]);
    } catch {
        /* not installed yet, or not root -- enrol still works, install fixes ownership */
    }
}

// Copy the server next to where the unit will point, exactly as the client's install_copy does, and
// for the same reason: a unit whose ExecStart lives on a mounted path is a box that fails to start
// the service at boot with 203/EXEC, because systemd gets there long before the share is mounted.
// iotgate happens to keep /opt on local disk, but tst-2 has it on CIFS, and the failure is silent
// until a reboot. Default target is install-dir from the host's cfg (/usr/local/lib/dialout).
// Only the host's own cfg goes with it: the template is never read there, so it is not copied.
function installCopy(dst) {
    // checked before anything is written, so a partial checkout cannot leave a box with no unit
    for (const need of [path.join('systemd', 'dialout-server.service'), 'dialout-seen']) {
        if (!fs.existsSync(path.join(HERE, need)))
            die(`install: ${path.join(HERE, need)} is missing -- install from a full checkout`);
    }
    fs.mkdirSync(path.join(dst, 'systemd'), { recursive: true });
    if (fs.realpathSync(HERE) === fs.realpathSync(dst)) {
        log(`install: running from ${dst} already -- nothing to copy; config is ${CFG_FILE || '(none -- built-in defaults)'}`);
        return;
    }
    const put = (rel, mode) => {
        const src = path.join(HERE, rel);
        if (!fs.existsSync(src)) return;
        const tmp = path.join(dst, `${rel}.tmp`);
        fs.copyFileSync(src, tmp);
        fs.chmodSync(tmp, mode);
        fs.renameSync(tmp, path.join(dst, rel)); // rename so a reader never sees a half-written file
    };
    put(SELF, 0o755);
    put('dialout-seen', 0o755); // the forced command behind every key; must be local, not on a share
    put(path.join('systemd', 'dialout-server.service'), 0o644);
    log(`install: copied the server to ${dst}`);
    installCfg(dst);
}

// The config gets its own step, and says exactly what it did, because it is the one file whose
// absence does not stop anything: a missing host cfg just means built-in defaults, which on a server
// means no DNS -- a box that installs cleanly and then quietly publishes nothing.
function installCfg(dst) {
    const name = `dialout.${os.hostname()}.cfg`;
    const src = path.join(HERE, name);
    const to = path.join(dst, name);
    const had = fs.existsSync(to);
    if (fs.existsSync(src)) {
        const same = had && fs.readFileSync(src).equals(fs.readFileSync(to));
        if (!same) {
            const tmp = `${to}.tmp`;
            fs.copyFileSync(src, tmp);
            fs.chmodSync(tmp, 0o600); // the whole config, which can hold a Cloudflare token
            fs.renameSync(tmp, to);
        }
        log(`install: config ${src} -> ${to} ${same ? '(unchanged)' : had ? '(REPLACED: it differed)' : '(new)'}`);
    } else if (had) warn(`install: no ${src} -- KEEPING the installed ${to}, which is not from this checkout`);
    else warn(`install: no ${src} and none installed -- the service will run on built-in defaults (no DNS); copy dialout.cfg to ${src}, fill it in, and install again`);
    // An install from before the template stopped being read left a copy here. Take it away so
    // nothing in the install dir looks as if it mattered when it does not.
    const stale = path.join(dst, 'dialout.cfg');
    if (fs.existsSync(stale)) {
        fs.unlinkSync(stale);
        log(`install: removed ${stale} (the template, no longer read)`);
    }
    log(`install: the service reads ${fs.existsSync(to) ? to : '(no config -- built-in defaults)'} and nothing else`);
}

// Existing enrolments carry command="/bin/false" from before there was anything to record, and an
// install after a move carries the old install-dir. Rewrite just the command, never the key: the
// name comes from the line's own `dialout:<name>` comment, so an operator's hand-edited line with a
// different comment is left alone rather than silently repointed.
function migrateAuthKeys(dst) {
    if (!fs.existsSync(authKeys())) return;
    const want = seenCmd(dst);
    let n = 0;
    const out = fs
        .readFileSync(authKeys(), 'utf8')
        .split('\n')
        .map((line) => {
            const m = line.match(/dialout:([A-Za-z0-9._-]+)\s*$/);
            if (!m || !line.includes('command="')) return line;
            const fixed = line.replace(/command="[^"]*"/, `command="${want} ${m[1]}"`);
            if (fixed !== line) n++;
            return fixed;
        });
    if (!n) return;
    const tmp = `${authKeys()}.tmp`;
    fs.writeFileSync(tmp, out.join('\n'), { mode: 0o600 });
    fs.renameSync(tmp, authKeys());
    log(`install: pointed ${n} enrolled key(s) at ${want}`);
}

// ------------------------------------------------------------------------------------------------
// backup / restore -- moving a server, or standing up a second one
// ------------------------------------------------------------------------------------------------
//
// What actually matters here is the HOST KEY. Clients pin it (accept-new into their own known_hosts),
// so a replacement or second server that generates a fresh one is rejected by every client that
// already knows the old one -- a failure that looks like a broken key rather than the wrong server.
// Carry host_key across and both ends are interchangeable. The rest is the register (authorized_keys,
// which holds the enrolments and their tags), the invite list, and the liveness stamps.

const backupParts = () => [
    { from: hostKey(), to: 'state/host_key' },
    { from: `${hostKey()}.pub`, to: 'state/host_key.pub' },
    { from: authKeys(), to: 'state/home/.ssh/authorized_keys' },
    { from: inviteFile(), to: 'state/invites.json' },
    { from: seenDir(), to: 'state/seen' },
];

function actionBackup(argv = []) {
    let out = '';
    let withConfig = true;
    for (let i = 0; i < argv.length; i++) {
        if (argv[i] === '--no-config') withConfig = false;
        else if (!out) out = argv[i];
    }
    const stamp = ts().replace(/[-:]/g, '').replace('T', '-').replace('Z', '');
    if (!out) out = path.resolve(`dialout-backup-${os.hostname()}-${stamp}.tar.gz`);
    const dst = cfg('install-dir', '/usr/local/lib/dialout');
    const stage = fs.mkdtempSync('/tmp/dialout-backup.');
    try {
        let n = 0;
        for (const part of backupParts()) {
            if (!fs.existsSync(part.from)) continue;
            const to = path.join(stage, part.to);
            fs.mkdirSync(path.dirname(to), { recursive: true });
            fs.cpSync(part.from, to, { recursive: true, preserveTimestamps: true });
            n++;
        }
        const cfgs = [];
        if (withConfig)
            for (const f of [`dialout.${os.hostname()}.cfg`]) {
                const from = path.join(dst, f);
                if (!fs.existsSync(from)) continue;
                fs.mkdirSync(path.join(stage, 'config'), { recursive: true });
                fs.cpSync(from, path.join(stage, 'config', f));
                cfgs.push(f);
            }
        // Say plainly whether the Cloudflare token travels with this or not. On a box that reaches it
        // through iotdata-conf it does NOT: that file is not dialout's to copy, and a restored server
        // without it comes up unable to publish anything, which looks like a DNS fault.
        let tokenInCfg = false;
        for (const f of cfgs) {
            // [ \t] not \s: \s matches the newline, so an EMPTY setting would happily match the
            // first word of the following line and report a token that is not there.
            const t = /^[ \t]*cloudflare-token[ \t]*=[ \t]*(\S+)[ \t]*$/m.exec(fs.readFileSync(path.join(stage, 'config', f), 'utf8'));
            if (t) tokenInCfg = true;
        }
        const tokenNote = tokenInCfg
            ? 'INCLUDED in the config above -- treat this tarball as a secret'
            : cfg('cloudflare-token', '')
              ? `NOT included: this host reads it from ${cfg('iotdata-conf', '(iotdata-conf)')}, which is not dialout's to copy. The restored host needs its own, or cloudflare-token= in its per-host cfg`
              : 'not set on this host (this server publishes no DNS)';
        fs.writeFileSync(
            path.join(stage, 'MANIFEST'),
            [
                'dialout-server backup',
                `host          ${os.hostname()}`,
                `date          ${ts()}`,
                `state-dir     ${stateDir()}`,
                `install-dir   ${dst}`,
                `clients       ${clients().length}`,
                `host key      ${hostKeyFingerprint() || '(none)'}`,
                `config        ${cfgs.length ? cfgs.join(' ') : '(not included)'}`,
                `cf token      ${tokenNote}`,
                '',
                'Restore with: dialout-server restore <this file>',
                'The host key in here is what makes a second server interchangeable with the first:',
                'clients pin it, so both ends must present the same one.',
                '',
            ].join('\n')
        );
        run('tar', ['-czf', out, '-C', stage, '.']);
        fs.chmodSync(out, 0o600); // it holds the host key, and usually a Cloudflare token as well
        log(`backup: ${out} (${n} state item(s), ${clients().length} clients${cfgs.length ? `, config: ${cfgs.join(' ')}` : ', no config'})`);
        if (tokenInCfg) warn('that tarball contains your Cloudflare token -- it is mode 600, keep it that way');
        else if (cfg('cloudflare-token', '')) log(`backup: the Cloudflare token is NOT in it -- this host reads it from ${cfg('iotdata-conf', '?')}`);
    } finally {
        fs.rmSync(stage, { recursive: true, force: true });
    }
}

function actionRestore(argv = []) {
    if (process.getuid() !== 0) die('restore: needs root');
    let src = '';
    let force = false;
    for (const a of argv) {
        if (a === '--force') force = true;
        else if (!src) src = a;
    }
    if (!src) die('restore: need the backup file (dialout-server restore dialout-backup-....tar.gz)');
    if (!fs.existsSync(src)) die(`restore: ${src} does not exist`);
    // Restoring under a running server would swap its host key and register beneath it.
    let active = false;
    try {
        active = run('systemctl', ['is-active', 'dialout-server']) === 'active';
    } catch {
        /* not installed, or not running */
    }
    if (active && !force) die('restore: the dialout-server service is running -- stop it first (or --force)');

    const stage = fs.mkdtempSync('/tmp/dialout-restore.');
    try {
        run('tar', ['-xzf', path.resolve(src), '-C', stage]);
        const man = path.join(stage, 'MANIFEST');
        if (!fs.existsSync(path.join(stage, 'state', 'host_key'))) die('restore: that does not look like a dialout backup (no state/host_key)');
        if (fs.existsSync(man)) for (const l of fs.readFileSync(man, 'utf8').split('\n').slice(1, 8)) if (l.trim()) log(`restore: ${l}`);

        // Say what is about to be replaced, in the terms that matter: whose key, and whose clients.
        if (fs.existsSync(hostKey()) && !force) {
            log(`restore: ${stateDir()} already has a host key ${hostKeyFingerprint() || ''} and ${clients().length} client(s)`);
            die('restore: refusing to overwrite an existing server -- move it aside, or --force if that is what you mean');
        }
        fs.mkdirSync(stateDir(), { recursive: true });
        fs.cpSync(path.join(stage, 'state'), stateDir(), { recursive: true, preserveTimestamps: true });
        fs.chmodSync(hostKey(), 0o600);
        if (fs.existsSync(authKeys())) fs.chmodSync(authKeys(), 0o600);
        chownState();
        log(`restore: state into ${stateDir()} -- host key ${hostKeyFingerprint() || '?'}, ${clients().length} client(s)`);

        // Config, if it came along. The per-host overlay is READ BY HOSTNAME, so on a different box it
        // has to be renamed or it is silently ignored -- which would lose the Cloudflare token and
        // leave the server unable to publish anything.
        const dst = cfg('install-dir', '/usr/local/lib/dialout');
        const cdir = path.join(stage, 'config');
        if (fs.existsSync(cdir)) {
            fs.mkdirSync(dst, { recursive: true });
            for (const f of fs.readdirSync(cdir)) {
                // Older backups carried the template too. It is not read any more, so restoring it
                // would only leave a file beside the real config that looks as if it mattered.
                if (f === 'dialout.cfg') {
                    log(`restore: config ${f} skipped (the template is not read; the host's own cfg is the config)`);
                    continue;
                }
                const m = /^dialout\.(.+)\.cfg$/.exec(f);
                const here = m && m[1] !== 'cfg' ? `dialout.${os.hostname()}.cfg` : f;
                const to = path.join(dst, here);
                if (fs.existsSync(to)) {
                    warn(`restore: ${to} exists already -- left alone; the backup's copy is in ${cdir} if you want to merge it`);
                    continue;
                }
                fs.cpSync(path.join(cdir, f), to);
                fs.chmodSync(to, here.startsWith('dialout.') && here !== 'dialout.cfg' ? 0o600 : 0o644);
                log(`restore: config ${f}${here !== f ? ` -> ${here} (renamed for this host)` : ''}`);
            }
        }
        log(`restore: done. Next: ${SELF} install, then systemctl enable --now dialout-server`);
        warn('two servers must not both publish DNS for the same names -- leave cloudflare-token empty on the spare, or they will overwrite each other every dns-refresh');
    } finally {
        fs.rmSync(stage, { recursive: true, force: true });
    }
}

function actionInstall(argv = []) {
    if (process.getuid() !== 0) die('install: needs root');
    let prefix = '';
    for (let i = 0; i < argv.length; i++) if (argv[i] === '--prefix') prefix = argv[++i] || die('--prefix needs a directory');
    const dst = prefix || cfg('install-dir', '/usr/local/lib/dialout');
    const user = cfg('ssh-user', 'dialoutd');
    try {
        run('id', [user]);
    } catch {
        // --user-group so it gets a group of its own: on Debian a bare `dialout` group already
        // exists for serial access, and quietly joining it would grant every client key /dev/tty*.
        //
        // /bin/sh, not nologin: dropbear checks the account's shell against /etc/shells and refuses
        // the login outright if it is not there ("User 'x' has invalid shell, rejected"), so a
        // nologin account cannot even open a tunnel. The account is locked down where it actually
        // works instead -- every authorized_keys line carries command="/bin/false" and no-pty, and
        // dropbear runs with -w (no root) and -j (no local forwarding). A client that asks for a
        // shell gets /bin/false; a client using -N never opens a session channel at all.
        run('useradd', ['--system', '--user-group', '--home-dir', homeDir(), '--shell', '/bin/sh', user]);
        run('passwd', ['-l', user]);
        log(`created user ${user}`);
    }
    fs.mkdirSync(path.dirname(authKeys()), { recursive: true, mode: 0o700 });
    if (!fs.existsSync(authKeys())) fs.writeFileSync(authKeys(), '', { mode: 0o600 });
    ensureHostKey();
    chownState();
    installCopy(dst);
    migrateAuthKeys(dst);
    chownState(); // again: the seen dir exists now, and the ping writes it as the dialout account
    const bin = path.join(dst, SELF);
    const unit = fs
        .readFileSync(path.join(HERE, 'systemd', 'dialout-server.service'), 'utf8')
        .replace(/@NODE@/g, process.execPath)
        .replace(/@BIN@/g, bin);
    fs.writeFileSync('/etc/systemd/system/dialout-server.service', unit);
    run('systemctl', ['daemon-reload']);
    log(`installed /etc/systemd/system/dialout-server.service running ${bin}`);
    let active = false;
    try {
        active = run('systemctl', ['is-active', 'dialout-server']) === 'active';
    } catch {
        // is-active exits non-zero when it is not running, which is not an error here
    }
    // The config is read once, at startup, so this applies to a config edit as much as to new code.
    if (active) log('the running service still has the old code and config -- pick them up with: systemctl restart dialout-server');
    else log(`enable it with: systemctl enable --now dialout-server   (or just run '${SELF} run' in a terminal)`);
}

function actionUninstall() {
    if (process.getuid() !== 0) die('uninstall: needs root');
    try {
        run('systemctl', ['disable', '--now', 'dialout-server']);
    } catch {
        /* not enabled */
    }
    fs.rmSync('/etc/systemd/system/dialout-server.service', { force: true });
    run('systemctl', ['daemon-reload']);
    log('uninstalled (state dir and keys left alone)');
}

// The daemon. Same code whether systemd started it or you did; it logs to stdout and nothing else,
// so `dialout-server run` in a terminal is a first-class way to operate this.
function actionRun(argv) {
    const force = argv.includes('--force');
    try {
        // Under systemd this process IS the service, and is-active says so -- refusing on that alone
        // made the unit kill itself on every start and restart forever. Only a DIFFERENT process
        // owning the service is a conflict, so compare its main pid with ours.
        if (run('systemctl', ['is-active', 'dialout-server']) === 'active' && !force) {
            const mainPid = parseInt(run('systemctl', ['show', '-p', 'MainPID', '--value', 'dialout-server']), 10);
            if (mainPid !== process.pid) die("the dialout-server service is already running -- stop it, or pass --force if you know what you're doing");
        }
    } catch {
        /* not installed, or systemctl absent: fine, that is the common case for a hand-run */
    }

    ensureHostKey();
    if (!fs.existsSync(authKeys())) warn(`no ${authKeys()} -- no client can log in until one is enrolled`);

    let child = null,
        stopping = false;
    const start = () => {
        child = spawnDropbear();
        log(`sshd started on ${cfg('bind', '0.0.0.0')}:${cfg('port-internal', 47022)} (pid ${child.pid})`);
        child.on('exit', (code, sig) => {
            if (stopping) return;
            warn(`sshd exited (${sig || code}) -- restarting in 5s`);
            setTimeout(start, 5000);
        });
    };
    start();

    let lastIp = null;
    const reconcileDns = () => {
        if (!cfg('dns-domain', '') || !cfg('cloudflare-token', '')) return;
        const ip = publicIp();
        if (!ip) return warn('dns: could not determine public IP');
        try {
            if (ip !== lastIp) {
                const a = publishA(ip);
                if (a !== 'unchanged') log(`dns: A ${dnsTarget()} -> ${ip} (${a})`);
                lastIp = ip;
            }
            const s = publishSrv(cfgN('port-external', 47022));
            if (s !== 'unchanged') log(`dns: SRV ${srvName()} -> ${dnsTarget()}:${cfg('port-external', 47022)} (${s})`);
            // sweep expired invitations so a stale entry cannot keep a box dialling in
            const inv = readInvites(),
                now = Math.floor(Date.now() / 1000);
            let swept = false;
            for (const [t, e] of Object.entries(inv))
                if (e.expires && e.expires <= now) {
                    delete inv[t];
                    swept = true;
                    log(`invite for ${e.name || t} expired`);
                }
            if (swept) writeInvites(inv);
            const i = publishInvites(inv);
            if (i !== 'unchanged') log(`dns: TXT ${inviteName()} (${i})`);
        } catch (e) {
            warn(`dns: ${e.message}`);
        }
    };

    const reconcileUpnp = () => {
        if (cfg('upnp', '1') !== '1') return;
        const r = upnpAssert();
        (r.ok ? log : warn)(`upnp: ${r.message}`);
    };

    reconcileUpnp();
    reconcileDns();
    setInterval(reconcileUpnp, cfgN('upnp-refresh', 1800) * 1000);
    setInterval(reconcileDns, cfgN('dns-refresh', 300) * 1000);

    // report tunnels coming and going, so a terminal running this is also a fleet monitor
    let seen = new Set();
    setInterval(() => {
        const up = listening();
        for (const c of clients()) {
            const label = c.tag ? `${c.name} (${c.tag})` : c.name;
            if (up.has(c.port) && !seen.has(c.port)) {
                log(`tunnel UP   ${label} -> 127.0.0.1:${c.port}`);
                seenStamp(c.name); // a live tunnel is the strongest liveness there is
            }
            if (!up.has(c.port) && seen.has(c.port)) log(`tunnel DOWN ${label}`);
        }
        seen = up;
    }, 5000);

    const stop = () => {
        stopping = true;
        if (child) child.kill();
        log('stopped');
        process.exit(0);
    };
    process.on('SIGINT', stop);
    process.on('SIGTERM', stop);
}

// ------------------------------------------------------------------------------------------------

const argv = process.argv.slice(2);
let explicitCfg = null;
while (argv[0] === '--config') {
    argv.shift();
    explicitCfg = argv.shift();
}
CFG = cfgLoad(explicitCfg);

// `--wait-for X` as a bare option, because that is how it reads in a terminal
if (argv[0] === '--wait-for') argv.unshift('wait');

const cmd = argv.shift() || 'status';
const actions = {
    run: actionRun,
    wait: actionWait,
    invite: actionInvite,
    uninvite: actionUninvite,
    enrol: actionEnrol,
    enroll: actionEnrol,
    revoke: actionRevoke,
    clients: actionClients,
    tag: actionTag,
    status: actionStatus,
    install: actionInstall,
    backup: actionBackup,
    restore: actionRestore,
    uninstall: actionUninstall,
    keygen: () => {
        ensureHostKey();
        console.log(hostKeyFingerprint() || hostKey());
    },
    // while the lines are still comments, not a hardcoded count -- the header grows, and a fixed
    // range silently starts printing the code below it
    help: () => {
        const out = [];
        for (const l of fs.readFileSync(path.join(HERE, SELF), 'utf8').split('\n').slice(2)) {
            if (!l.startsWith('//')) {
                if (out.length) break; // past the block
                continue; // blank lines between 'use strict' and it
            }
            out.push(l.replace(/^\/\/ ?/, ''));
        }
        console.log(out.join('\n'));
    },
};
if (!actions[cmd]) die(`unknown command '${cmd}' (try: ${Object.keys(actions).join(' ')})`);
try {
    actions[cmd](argv);
} catch (e) {
    die(e.message);
}
