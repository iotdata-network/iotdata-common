# /etc/ppp/peers/a7670e-lebara -- SIMCom A7670E on the Pi header UART, Lebara UK SIM.
#
#   pppd call a7670e-lebara updetach     dial, and exit 0 once the link is actually up
#   pkill -f 'pppd call a7670e-lebara'   hang up
#
# Mode 600: it holds the APN password.

/dev/serial0
115200
connect "/usr/sbin/chat -v -f /etc/ppp/chat/a7670e-lebara"

# The APN wants PAP (Lebara UK: wap/wap). The peer does not authenticate to us.
noauth
user wap
password wap

# Two wires and a ground: no modem control lines, no hardware flow control.
local
nocrtscts

# This image boots with ipv6.disable=1, so there is no IPv6 stack at all -- /proc/sys/net/ipv6 does
# not even exist. Without this, pppd still tries IPV6CP on every dial and logs two copies of
# "IPv6 socket creation failed: Address family not supported by protocol" for nothing.
noipv6

# Let the carrier give us both addresses. NO usepeerdns, deliberately: Debian's ppp ships
# /etc/ppp/ip-up.d/0000usepeerdns, which (with no resolvconf and no systemd-resolved, which is this
# image) REWRITES /etc/resolv.conf to the carrier's own resolver and nothing else. That resolver is a
# carrier-private address, so it is only reachable while ppp0 holds the default route -- meaning that
# on the bench, where ethernet holds it, every name lookup on the box fails for as long as the modem
# is up. It cost a confusing hour: dialout kept reporting "not invited" because its DNS lookup died,
# not because the invite was missing. We do not need it either way: the image resolves via Quad9, and
# Quad9 was verified working over this APN (dig @9.9.9.9 routed out ppp0 answers fine), so DNS works
# on the bench over ethernet and in the field over ppp0.
noipdefault

# Notice a dead link instead of sitting on it.
lcp-echo-interval 10
lcp-echo-failure 3
maxfail 1

# In the field this modem IS the network, so it carries the default route. On the bench, where the
# box is on ethernet, dialout-link passes nodefaultroute on the command line to override this.
defaultroute
